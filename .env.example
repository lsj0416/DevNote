# ----------------------------------------
# DevNote AI 환경변수 설정
# 이 파일을 복사해서 .env로 만들고 값을 채워주세요
# cp .env.example .env
# ----------------------------------------
# .env는 절대 Git에 올리지 마세요 (.gitignore에 이미 포함되어 있습니다)
# ----------------------------------------

# ─── Database (Prisma + Neon Postgres) ───
# Story 1.2에서 사용
DATABASE_URL=

# ─── Auth.js ──────────────────────────────
# Story 1.3에서 사용. AUTH_SECRET은 `npx auth secret`으로 생성 가능
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ─── OpenAI ────────────────────────────────
# Story 4.1, 5.1에서 사용. https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=
